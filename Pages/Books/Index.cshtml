@page
@model Moroti_Madalina_Lab2.Pages.Books.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Books</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Author</th>
            <th>Price</th>
            <th>Publishing Date</th>
            <th>Categories</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.BookData.Books)
        {
            <tr>
                <td>@Html.DisplayFor(model => item.Title)</td>
                <td>@Html.DisplayFor(model => item.Author)</td>
                <td>@Html.DisplayFor(model => item.Price)</td>
                <td>@Html.DisplayFor(model => item.PublishingDate)</td>
                <td>
                    @{
                        foreach (var category in item.BookCategories)
                        {
                            @category.Category.CategoryName <text> </text>
                        }
                    }
                </td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.ID">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@item.ID">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@item.ID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
