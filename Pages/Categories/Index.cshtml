@page
@model Moroti_Madalina_Lab2.Pages.Categories.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Categories</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Category Name</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.CategoryData.Categories)
        {
            string selectedRow = "";

            if (item.ID == Model.CategoryID)
            {
                selectedRow = "table-success";
            }

            <tr class="@selectedRow">
                <td>
                    <a asp-page="./Index" asp-route-id="@item.ID">
                        @item.CategoryName
                    </a>
                </td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.ID">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@item.ID">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@item.ID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.CategoryID != 0)
{
    <h3>Books in Selected Category</h3>

    @if (Model.CategoryData.Books.Any())
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Book Title</th>
                    <th>Author</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var book in Model.CategoryData.Books)
                {
                    <tr>
                        <td>@book.Title</td>
                        <td>@book.Author</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No books found in this category.</p>
    }
}
